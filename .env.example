# MySQL (compose에서 오버라이드됨)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/linkid_ai?currentSchema=public
SPRING_DATASOURCE_USERNAME=linkid_user
SPRING_DATASOURCE_PASSWORD=linkid_password
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT (64바이트 이상 base64 시크릿 — 사용자가 채움)
# 생성 예: openssl rand -base64 64
JWT_SECRET=

# LINKid-AI 연동
AI_SERVER_URL=http://linkid-ai:8000

# NCloud Object Storage (사용자가 채움 — @Value: ncloud.object-storage.*)
NCLOUD_OBJECT_STORAGE_ACCESS_KEY=
NCLOUD_OBJECT_STORAGE_SECRET_KEY=
NCLOUD_OBJECT_STORAGE_ENDPOINT=https://kr.object.ncloudstorage.com
NCLOUD_OBJECT_STORAGE_REGION=kr-standard
NCLOUD_OBJECT_STORAGE_BUCKET_NAME=

# NCloud Clova Speech (사용자가 채움 — @Value: ncloud.clova-speech.*)
NCLOUD_CLOVA_SPEECH_SECRET_KEY=
NCLOUD_CLOVA_SPEECH_INVOKE_URL=
